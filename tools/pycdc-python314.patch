+/* Python 3.14 attaches inline caches to more opcodes than 3.13 did, and a
+   relative jump is measured from the instruction *after* those caches.
+   Skipping them keeps `pos` on the next real instruction. */
+int Pyc::InlineCacheCount(int maj, int min, int opcode)
+{
+    if (maj != 3 || min < 14)
+        return 0;
+
+    switch (opcode) {
+        case Pyc::BINARY_OP_A:                  return 5;
+        case Pyc::CALL_A:                       return 3;
+        case Pyc::CALL_KW_A:                    return 3;
+        case Pyc::COMPARE_OP_A:                 return 1;
+        case Pyc::CONTAINS_OP_A:                return 1;
+        case Pyc::FOR_ITER_A:                   return 1;
+        case Pyc::JUMP_BACKWARD_A:              return 1;
+        case Pyc::LOAD_ATTR_A:                  return 9;
+        case Pyc::LOAD_GLOBAL_A:                return 4;
+        case Pyc::LOAD_SUPER_ATTR_A:            return 1;
+        case Pyc::POP_JUMP_IF_FALSE_A:          return 1;
+        case Pyc::POP_JUMP_IF_NONE_A:           return 1;
+        case Pyc::POP_JUMP_IF_NOT_NONE_A:       return 1;
+        case Pyc::POP_JUMP_IF_TRUE_A:           return 1;
+        case Pyc::SEND_A:                       return 1;
+        case Pyc::STORE_ATTR_A:                 return 4;
+        case Pyc::STORE_SUBSCR:                 return 1;
+        case Pyc::TO_BOOL:                      return 3;
+        case Pyc::UNPACK_SEQUENCE_A:            return 1;
+    default:
+        return 0;
+    }
+}
